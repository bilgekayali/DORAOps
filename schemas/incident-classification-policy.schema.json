{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/incident-classification-policy.schema.json",
  "title": "DORAOps Incident Classification Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "policy_id", "version", "required_impact_dimensions", "require_recovery_event", "require_root_cause_reference", "require_remediation_reference", "require_notification_decision"],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "required_impact_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["service_availability", "data_confidentiality", "data_integrity", "data_availability", "client_impact", "financial_impact", "geographic_spread", "reputational_impact", "other"]}
    },
    "require_recovery_event": {"type": "boolean"},
    "require_root_cause_reference": {"type": "boolean"},
    "require_remediation_reference": {"type": "boolean"},
    "require_notification_decision": {"type": "boolean"}
  }
}
