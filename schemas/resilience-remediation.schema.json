{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/resilience-remediation.schema.json",
  "title": "DORAOps Resilience Remediation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_digest", "remediation_id", "owner_id", "completed_at", "summary", "evidence_digest"],
  "properties": {
    "finding_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "remediation_id": {"type": "string", "minLength": 1},
    "owner_id": {"type": "string", "minLength": 1},
    "completed_at": {"type": "integer", "minimum": 0},
    "summary": {"type": "string", "minLength": 1},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}