{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/portfolio-assurance-snapshot.schema.json",
  "title": "DORAOps v0.4 Portfolio Assurance Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "portfolio_id",
    "snapshot_id",
    "sequence",
    "policy_digest",
    "positions",
    "provider_exposures",
    "state",
    "findings",
    "assembled_at",
    "dora_compliance_determined",
    "operational_resilience_determined",
    "supervisory_acceptance_determined",
    "legal_concentration_risk_determined",
    "requires_human_review"
  ],
  "properties": {
    "portfolio_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity_position"}
    },
    "provider_exposures": {
      "type": "array",
      "items": {"$ref": "#/$defs/provider_exposure"}
    },
    "state": {"enum": ["healthy", "attention", "incomplete", "breached", "revalidation_required"]},
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assembled_at": {"type": "integer", "minimum": 0},
    "dora_compliance_determined": {"const": false},
    "operational_resilience_determined": {"const": false},
    "supervisory_acceptance_determined": {"const": false},
    "legal_concentration_risk_determined": {"const": false},
    "requires_human_review": {"const": true}
  },
  "$defs": {
    "domain_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "artifact_count", "current_count", "gap_count", "revalidation_count", "state", "findings"],
      "properties": {
        "domain": {"enum": ["ict_risk", "incident", "incident_reporting", "resilience_test", "continuity", "third_party"]},
        "artifact_count": {"type": "integer", "minimum": 0},
        "current_count": {"type": "integer", "minimum": 0},
        "gap_count": {"type": "integer", "minimum": 0},
        "revalidation_count": {"type": "integer", "minimum": 0},
        "state": {"enum": ["healthy", "attention", "incomplete", "breached", "revalidation_required"]},
        "findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "entity_provider_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "provider_id", "arrangement_ids", "supported_function_ids", "critical_function_ids", "high_or_critical_observation_count"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "arrangement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supported_function_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "critical_function_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "high_or_critical_observation_count": {"type": "integer", "minimum": 0}
      }
    },
    "entity_position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id", "dossier_digest", "dossier_generated_at", "source_revision", "policy_digest", "assessed_at",
        "freshness_state", "domain_summaries", "provider_exposures", "critical_function_ids", "state", "findings",
        "dora_compliance_determined", "operational_resilience_determined", "supervisory_acceptance_determined", "requires_human_review"
      ],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "dossier_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dossier_generated_at": {"type": "integer", "minimum": 0},
        "source_revision": {"type": "string", "minLength": 1},
        "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "assessed_at": {"type": "integer", "minimum": 0},
        "freshness_state": {"enum": ["healthy", "revalidation_required"]},
        "domain_summaries": {"type": "array", "items": {"$ref": "#/$defs/domain_summary"}},
        "provider_exposures": {"type": "array", "items": {"$ref": "#/$defs/entity_provider_exposure"}},
        "critical_function_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "state": {"enum": ["healthy", "attention", "incomplete", "breached", "revalidation_required"]},
        "findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dora_compliance_determined": {"const": false},
        "operational_resilience_determined": {"const": false},
        "supervisory_acceptance_determined": {"const": false},
        "requires_human_review": {"const": true}
      }
    },
    "provider_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id", "entity_ids", "arrangement_count", "critical_function_refs", "high_or_critical_observation_count",
        "entity_concentration_threshold_reached", "critical_function_concentration_threshold_reached", "legal_concentration_risk_determined"
      ],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "entity_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "arrangement_count": {"type": "integer", "minimum": 1},
        "critical_function_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "high_or_critical_observation_count": {"type": "integer", "minimum": 0},
        "entity_concentration_threshold_reached": {"type": "boolean"},
        "critical_function_concentration_threshold_reached": {"type": "boolean"},
        "legal_concentration_risk_determined": {"const": false}
      }
    }
  }
}