{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/provider-portfolio-exposure.schema.json",
  "title": "DORAOps v0.4 Provider Portfolio Exposure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "entity_ids",
    "arrangement_count",
    "critical_function_refs",
    "high_or_critical_observation_count",
    "entity_concentration_threshold_reached",
    "critical_function_concentration_threshold_reached",
    "legal_concentration_risk_determined"
  ],
  "properties": {
    "provider_id": {"type": "string", "minLength": 1},
    "entity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "arrangement_count": {"type": "integer", "minimum": 1},
    "critical_function_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "high_or_critical_observation_count": {"type": "integer", "minimum": 0},
    "entity_concentration_threshold_reached": {"type": "boolean"},
    "critical_function_concentration_threshold_reached": {"type": "boolean"},
    "legal_concentration_risk_determined": {"const": false}
  }
}