{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bilgekayali/DORAOps/schemas/tenant-context.schema.json",
  "title": "DORAOps Tenant Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_id",
    "principal_id",
    "roles",
    "issuer",
    "audience",
    "token_expires_at",
    "mfa_verified",
    "production_identity_validated"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "entity_id": {"type": "string", "minLength": 1},
    "principal_id": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issuer": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "token_expires_at": {"type": "integer", "minimum": 1},
    "mfa_verified": {"type": "boolean"},
    "production_identity_validated": {"const": false}
  }
}
