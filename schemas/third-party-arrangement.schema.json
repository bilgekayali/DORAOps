{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/third-party-arrangement.schema.json",
  "title": "DORAOps ICT Third-Party Arrangement",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "arrangement_id", "contract_reference", "direct_provider_id", "direct_service_ids", "subcontracted_service_ids", "supported_function_ids", "critical_or_important_function_ids", "provider_designation", "provider_designation_owner", "provider_designation_rationale", "inventory_snapshot_digest", "data_locations", "service_locations", "contract_evidence_digests", "control_requirement_evidence_digests", "effective_from", "effective_to"],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "arrangement_id": {"type": "string", "minLength": 1},
    "contract_reference": {"type": "string", "minLength": 1},
    "direct_provider_id": {"type": "string", "minLength": 1},
    "direct_service_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "subcontracted_service_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supported_function_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "critical_or_important_function_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provider_designation": {"enum": ["unassessed", "not_designated_critical", "designated_critical"]},
    "provider_designation_owner": {"type": "string", "minLength": 1},
    "provider_designation_rationale": {"type": "string", "minLength": 1},
    "inventory_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_locations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/location"}},
    "service_locations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/location"}},
    "contract_evidence_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "control_requirement_evidence_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "effective_from": {"type": "integer", "minimum": 0},
    "effective_to": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code", "region", "description"],
      "properties": {
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "region": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "description": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
      }
    }
  }
}
