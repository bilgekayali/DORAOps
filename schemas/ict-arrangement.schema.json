{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DORAOps ICT Arrangement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "institution_id", "arrangement_id", "provider_id", "function_id", "service_type", "contract_reference_digest", "supports_critical_or_important_function", "exit_plan_documented", "substitutability_assessed", "subcontracting_allowed", "data_location_countries", "registered_at"],
  "properties": {
    "schema_version": {"const": "doraops.ict-arrangement.v1"},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "arrangement_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "function_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "service_type": {"type": "string", "minLength": 1, "maxLength": 512},
    "contract_reference_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supports_critical_or_important_function": {"type": "boolean"},
    "exit_plan_documented": {"type": "boolean"},
    "substitutability_assessed": {"type": "boolean"},
    "subcontracting_allowed": {"type": "boolean"},
    "data_location_countries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
    "registered_at": {"type": "string", "format": "date-time"}
  }
}
