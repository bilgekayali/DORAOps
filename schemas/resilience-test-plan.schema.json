{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/resilience-test-plan.schema.json",
  "title": "DORAOps Resilience Test Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "test_id", "title", "test_type", "objective", "test_owner_id", "independent_reviewer_id", "inventory_snapshot_digest", "risk_decision_digests", "scope_nodes", "scenario", "planned_at", "tlpt_qualification_evidence_digest"],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "test_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "test_type": {"enum": ["scenario_based", "vulnerability_assessment", "network_security_assessment", "penetration_test", "source_code_review", "physical_security_review", "performance_test", "end_to_end_test", "threat_led_penetration_test", "other"]},
    "objective": {"type": "string", "minLength": 1},
    "test_owner_id": {"type": "string", "minLength": 1},
    "independent_reviewer_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "inventory_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "risk_decision_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "scope_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeRef"}},
    "scenario": {"type": "string", "minLength": 1},
    "planned_at": {"type": "integer", "minimum": 0},
    "tlpt_qualification_evidence_digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
  },
  "$defs": {
    "nodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "kind", "node_id"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["business_function", "business_process", "ict_service", "information_asset", "ict_asset", "third_party_service"]},
        "node_id": {"type": "string", "minLength": 1}
      }
    }
  }
}