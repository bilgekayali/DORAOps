{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/ict-incident.schema.json",
  "title": "DORAOps ICT Incident",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "incident_id", "title", "incident_owner_id", "occurred_at", "detected_at", "inventory_snapshot_digest", "affected_nodes"],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "incident_owner_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "integer", "minimum": 0},
    "detected_at": {"type": "integer", "minimum": 0},
    "inventory_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "affected_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeRef"}}
  },
  "$defs": {
    "nodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "kind", "node_id"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["business_function", "business_process", "ict_service", "information_asset", "ict_asset", "third_party_service"]},
        "node_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
