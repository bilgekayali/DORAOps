{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/ict-risk.schema.json",
  "title": "DORAOps ICT Risk Governance Artifact",
  "oneOf": [
    {"$ref": "#/$defs/scenario"},
    {"$ref": "#/$defs/control"},
    {"$ref": "#/$defs/policy"},
    {"$ref": "#/$defs/treatment"},
    {"$ref": "#/$defs/decision"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "kind", "node_id"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["business_function", "business_process", "ict_service", "information_asset", "ict_asset", "third_party_service"]},
        "node_id": {"type": "string", "minLength": 1}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "scenario_id", "title", "threat", "vulnerability", "risk_owner_id", "affected_nodes", "likelihood", "impact"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "threat": {"type": "string", "minLength": 1},
        "vulnerability": {"type": "string", "minLength": 1},
        "risk_owner_id": {"type": "string", "minLength": 1},
        "affected_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/node_ref"}},
        "likelihood": {"type": "integer", "minimum": 1, "maximum": 4},
        "impact": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "control_id", "name", "control_type", "effectiveness", "evidence_digest"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "control_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "control_type": {"type": "string", "minLength": 1},
        "effectiveness": {"type": "integer", "minimum": 0, "maximum": 3},
        "evidence_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "policy_id", "version", "medium_threshold", "high_threshold", "critical_threshold", "max_control_credit"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "policy_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "medium_threshold": {"type": "integer", "minimum": 2, "maximum": 16},
        "high_threshold": {"type": "integer", "minimum": 3, "maximum": 16},
        "critical_threshold": {"type": "integer", "minimum": 4, "maximum": 16},
        "max_control_credit": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment", "treatment_owner_id", "rationale", "target_timestamp"],
      "properties": {
        "treatment": {"enum": ["mitigate", "accept", "avoid", "transfer"]},
        "treatment_owner_id": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "target_timestamp": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "scenario_id", "inventory_snapshot_digest", "scenario_digest", "policy_digest", "control_digests", "inherent_score", "inherent_level", "control_credit", "residual_score", "residual_level", "treatment", "risk_acceptance_required", "remediation_required"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "inventory_snapshot_digest": {"$ref": "#/$defs/sha256"},
        "scenario_digest": {"$ref": "#/$defs/sha256"},
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "control_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "inherent_score": {"type": "integer", "minimum": 1, "maximum": 16},
        "inherent_level": {"enum": ["low", "medium", "high", "critical"]},
        "control_credit": {"type": "integer", "minimum": 0, "maximum": 8},
        "residual_score": {"type": "integer", "minimum": 1, "maximum": 16},
        "residual_level": {"enum": ["low", "medium", "high", "critical"]},
        "treatment": {"$ref": "#/$defs/treatment"},
        "risk_acceptance_required": {"type": "boolean"},
        "remediation_required": {"type": "boolean"}
      }
    }
  }
}
