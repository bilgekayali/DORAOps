{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/control-evidence-matrix.schema.json",
  "title": "DORAOps DORA Control Evidence Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_id", "matrix_version", "jurisdiction", "regulation", "mappings",
    "complete_legal_mapping_claimed", "dora_compliance_determined",
    "legal_applicability_determined", "supervisory_acceptance_determined",
    "requires_human_review", "schema_version"
  ],
  "properties": {
    "matrix_id": {"type": "string", "minLength": 1},
    "matrix_version": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "regulation": {"type": "string", "minLength": 1},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id", "title", "regulatory_references", "expected_evidence_types",
          "responsible_role", "verification_method", "applicability_basis"
        ],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "regulatory_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "article", "topic"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "article": {"type": "string", "minLength": 1},
                "topic": {"type": "string", "minLength": 1}
              }
            }
          },
          "expected_evidence_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "responsible_role": {"type": "string", "minLength": 1},
          "verification_method": {"type": "string", "minLength": 1},
          "applicability_basis": {"const": "institution_determined"}
        }
      }
    },
    "complete_legal_mapping_claimed": {"const": false},
    "dora_compliance_determined": {"const": false},
    "legal_applicability_determined": {"const": false},
    "supervisory_acceptance_determined": {"const": false},
    "requires_human_review": {"const": true},
    "schema_version": {"const": "doraops-control-evidence-matrix.v1"}
  }
}
