{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/resilience-test-execution.schema.json",
  "title": "DORAOps Resilience Test Execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_digest", "execution_id", "executed_at", "executor_id", "outcome", "evidence_digests", "notes"],
  "properties": {
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "minLength": 1},
    "executed_at": {"type": "integer", "minimum": 0},
    "executor_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["passed", "passed_with_findings", "failed", "incomplete"]},
    "evidence_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "notes": {"type": "string", "minLength": 1}
  }
}