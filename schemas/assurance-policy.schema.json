{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/assurance-policy.schema.json",
  "title": "DORAOps v0.4 Assurance Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "portfolio_id",
    "policy_id",
    "version",
    "required_domains",
    "max_dossier_age_seconds",
    "provider_entity_concentration_threshold",
    "critical_function_concentration_threshold",
    "owner_id",
    "registered_at"
  ],
  "properties": {
    "portfolio_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "required_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ict_risk",
          "incident",
          "incident_reporting",
          "resilience_test",
          "continuity",
          "third_party"
        ]
      }
    },
    "max_dossier_age_seconds": {"type": "integer", "minimum": 1},
    "provider_entity_concentration_threshold": {"type": "integer", "minimum": 1},
    "critical_function_concentration_threshold": {"type": "integer", "minimum": 1},
    "owner_id": {"type": "string", "minLength": 1},
    "registered_at": {"type": "integer", "minimum": 0}
  }
}