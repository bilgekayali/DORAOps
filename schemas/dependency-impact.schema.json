{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doraops.dev/schemas/dependency-impact.schema.json",
  "title": "DORAOps Modeled Dependency Impact Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id", "inventory_snapshot_digest", "origin_nodes", "direction", "maximum_depth",
    "impacted_nodes", "traversed_edge_digests", "generated_at", "runtime_impact_determined"
  ],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "inventory_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "origin_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeRef"}},
    "direction": {"enum": ["outbound", "inbound", "both"]},
    "maximum_depth": {"type": "integer", "minimum": 1},
    "impacted_nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeRef"}},
    "traversed_edge_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "generated_at": {"type": "integer", "minimum": 0},
    "runtime_impact_determined": {"const": false}
  },
  "$defs": {
    "nodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "kind", "node_id"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["business_function", "business_process", "ict_service", "information_asset", "ict_asset", "third_party_service"]},
        "node_id": {"type": "string", "minLength": 1}
      }
    }
  }
}