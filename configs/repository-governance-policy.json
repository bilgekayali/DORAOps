    "release-evidence-integrity",
    "security-boundary",
    "test (3.11)",
    "test (3.12)",
    "test (3.13)"
  ],
  "notes": "Repository-admin enforcement is reported separately from the versioned stable-reference policy. This policy intentionally requires zero mandatory reviewers for single-maintainer development."
